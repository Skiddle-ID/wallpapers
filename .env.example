# ==============================================================================
# Wallpaper Curator Pro - Environment Configuration
# Copy this file to .env and customize your settings
# ==============================================================================

# ── Server & Runtime Settings ────────────────────────────────────────────────
CURATE_PORT=8888
CURATE_HOST=127.0.0.1
PYTHONIOENCODING=utf-8

# Minimum resolution threshold in total pixels (default: 2560x1440 = 3686400)
# CURATE_MIN_PIXELS=3686400

# ── Git Auto-Publish Settings ────────────────────────────────────────────────
CURATE_GIT_BRANCH=main
CURATE_GIT_REMOTE=origin
# Minimum minutes between git pushes (rate limit guard)
# CURATE_GIT_MAX_PUSH_MIN=60
# Optional confirmation token required to trigger git-push endpoint
# CURATE_GIT_CONFIRM=

# ── Automatic Ingestion Sources ──────────────────────────────────────────────

# 1. DeviantArt API OAuth2 Credentials (required for DeviantArt automatic ingestion)
# Register a confidential app at: https://www.deviantart.com/developers/apps
# Scopes needed: browse
DEVIANTART_CLIENT_ID=
DEVIANTART_CLIENT_SECRET=

# 2. Wallhaven.cc API Key (optional — enables NSFW/SFW+ filters and private collections)
# Obtain at: https://wallhaven.cc/settings/account
WALLHAVEN_API_KEY=
